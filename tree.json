{
  "meta": {
    "title": "Ecosistema V4 - Demo",
    "description": "El futuro de la web impulsada por datos.",
    "network": {
      "type": "mesh",
      "density": 45,
      "lineColor": "#8b5cf6",
      "glowColor": "#ddd6fe",
      "radius": 180,
      "interaction": "repel"
    }
  },
  "masterNodes": {
    "header-template": {
      "tag": "header",
      "properties": {
        "style": {
          "background": "#2c3e50",
          "color": "white",
          "padding": "20px",
          "textAlign": "center"
        }
      },
      "children": [
        {
          "tag": "h1",
          "text": "Ecosistema V4",
          "properties": {
            "style": {
              "margin": "0"
            }
          }
        }
      ]
    }
  },
  "routes": {
    "/": {
      "targetNodePath": "root.home"
    },
    "/about": {
      "targetNodePath": "root.about"
    }
  },
  "root": {
    "tag": "div",
    "path": "root",
    "properties": {
      "style": {
        "fontFamily": "sans-serif"
      }
    },
    "children": [
      {
        "tag": "div",
        "path": "root.home",
        "properties": {
          "style": {
            "display": "block",
            "minHeight": "100vh"
          }
        },
        "children": [
          {
            "masterId": "header-template",
            "path": "root.home.header"
          },
          {
            "tag": "section",
            "path": "root.home.content",
            "properties": {
              "style": {
                "padding": "20px",
                "maxWidth": "800px",
                "margin": "0 auto"
              }
            },
            "children": [
              {
                "tag": "h2",
                "path": "root.home.content.title",
                "text": "Int\u00e9rprete de Datos de Alta Frecuencia",
                "properties": {
                  "style": {
                    "color": "#34495e"
                  }
                }
              },
              {
                "tag": "p",
                "path": "root.home.content.desc",
                "text": "Sitios web que pesan menos de 30KB. Todo renderizado directo desde JSON."
              },
              {
                "tag": "div",
                "path": "root.home.features",
                "properties": {
                  "style": {
                    "display": "flex",
                    "gap": "20px",
                    "marginTop": "20px"
                  }
                },
                "children": [
                  {
                    "tag": "div",
                    "path": "root.home.features.hydration",
                    "properties": {
                      "style": {
                        "flex": "1",
                        "padding": "15px",
                        "border": "1px solid #bdc3c7",
                        "borderRadius": "5px"
                      }
                    },
                    "children": [
                      {
                        "tag": "h3",
                        "path": "root.home.features.hydration.title",
                        "text": "API Hydration"
                      },
                      {
                        "tag": "div",
                        "path": "root.home.features.hydration.data",
                        "text": "Loading data...",
                        "directives": {
                          "fetch": "mock.json"
                        }
                      }
                    ]
                  },
                  {
                    "tag": "div",
                    "path": "root.home.features.forms",
                    "properties": {
                      "style": {
                        "flex": "1",
                        "padding": "15px",
                        "border": "1px solid #bdc3c7",
                        "borderRadius": "5px"
                      }
                    },
                    "children": [
                      {
                        "tag": "h3",
                        "path": "root.home.features.forms.title",
                        "text": "Form Sync (Inverse Reactivity)"
                      },
                      {
                        "tag": "input",
                        "path": "root.home.features.forms.input",
                        "text": "Escribe aqu\u00ed...",
                        "properties": {
                          "style": {
                            "width": "100%",
                            "padding": "8px",
                            "boxSizing": "border-box"
                          }
                        },
                        "directives": {
                          "sync": true
                        }
                      },
                      {
                        "tag": "p",
                        "path": "root.home.features.forms.output",
                        "text": "Escribe arriba para ver el Data Binding.",
                        "properties": {
                          "style": {
                            "marginTop": "10px",
                            "color": "#7f8c8d"
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "tag": "div",
                "path": "root.home.physics",
                "properties": {
                  "style": {
                    "marginTop": "40px",
                    "padding": "20px",
                    "background": "#ecf0f1",
                    "borderRadius": "5px"
                  }
                },
                "children": [
                  {
                    "tag": "h3",
                    "path": "root.home.physics.title",
                    "text": "Motor de F\u00edsica & Culling"
                  },
                  {
                    "tag": "div",
                    "path": "root.home.physics.ball",
                    "properties": {
                      "style": {
                        "width": "50px",
                        "height": "50px",
                        "backgroundColor": "#e74c3c",
                        "borderRadius": "25px",
                        "transform": "translate(0px, 0px)",
                        "transition": "transform 0.016s linear"
                      }
                    },
                    "directives": {
                      "physics": {
                        "velocity": {
                          "x": 0,
                          "y": 0
                        }
                      }
                    }
                  },
                  {
                    "tag": "button",
                    "path": "root.home.physics.btn",
                    "text": "Empujar Pelota",
                    "properties": {
                      "style": {
                        "marginTop": "20px",
                        "padding": "10px 20px",
                        "cursor": "pointer"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}